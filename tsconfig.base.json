{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "composite": false,
    "skipLibCheck": true,
    "paths": {
      "@matheustwn/atlas-agents": ["packages/agents/src/index.ts"],
      "@matheustwn/atlas-agents/*": ["packages/agents/src/*"],
      "@matheustwn/atlas-ai": ["packages/ai/src/index.ts"],
      "@matheustwn/atlas-ai/*": ["packages/ai/src/*"],
      "@matheustwn/atlas-api": ["apps/api/src/index.ts"],
      "@matheustwn/atlas-audit": ["engines/audit/src/index.ts"],
      "@matheustwn/atlas-auth": ["packages/auth/src/index.ts"],
      "@matheustwn/atlas-blueprint": ["packages/blueprint/src/index.ts"],
      "@matheustwn/atlas-blueprint/*": ["packages/blueprint/src/*"],
      "@matheustwn/atlas-cli": ["apps/twn-cli/src/index.ts"],
      "@matheustwn/atlas-cli/*": ["apps/twn-cli/src/*"],
      "@matheustwn/atlas-config": ["packages/config/src/index.ts"],
      "@matheustwn/atlas-constitution": ["engines/constitution/src/index.ts"],
      "@matheustwn/atlas-core": ["packages/core/src/index.ts"],
      "@matheustwn/atlas-core/*": ["packages/core/src/*"],
      "@matheustwn/atlas-database": ["packages/database/src/index.ts"],
      "@matheustwn/atlas-events": ["packages/events/src/index.ts"],
      "@matheustwn/atlas-evolution": ["engines/evolution/src/index.ts"],
      "@matheustwn/atlas-graph": ["packages/graph/src/index.ts"],
      "@matheustwn/atlas-graphql": ["apps/graphql/src/index.ts"],
      "@matheustwn/atlas-marketplace": ["apps/marketplace/src/index.ts"],
      "@matheustwn/atlas-mcp": ["packages/mcp/src/index.ts"],
      "@matheustwn/atlas-memory": ["packages/memory/src/index.ts"],
      "@matheustwn/atlas-orchestrator": ["packages/orchestrator/src/index.ts"],
      "@matheustwn/atlas-planning": ["engines/planning/src/index.ts"],
      "@matheustwn/atlas-redteam": ["engines/redteam/src/index.ts"],
      "@matheustwn/atlas-research": ["engines/research/src/index.ts"],
      "@matheustwn/atlas-score": ["engines/score/src/index.ts"],
      "@matheustwn/atlas-sdk": ["packages/sdk/src/index.ts"],
      "@matheustwn/atlas-simulation": ["engines/simulation/src/index.ts"],
      "@matheustwn/atlas-telemetry": ["packages/telemetry/src/index.ts"],
      "@matheustwn/atlas-vector": ["packages/vector/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", ".nx"]
}
